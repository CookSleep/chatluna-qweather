{
  "name": "chatluna-plugin-qweather",
  "version": "0.2.0",
  "description": "和风天气查询工具：城市搜索、实时天气、逐日/逐小时预报、分钟级降水与空气质量",
  "type": "module",
  "license": "GPL-3.0-only",
  "keywords": [
    "chatluna-plugin",
    "qweather",
    "weather"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CookSleep/chatluna-qweather.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "peerDependencies": {
    "@chatluna/schema": "*",
    "@chatluna/tool": "*",
    "cordis": "^4.0.0-rc.12"
  },
  "devDependencies": {
    "@chatluna/schema": "workspace:*",
    "@chatluna/tool": "workspace:*",
    "@cordisjs/plugin-http": "*",
    "cordis": "4.0.0-rc.12",
    "typescript": "*"
  },
  "cordis": {
    "description": {
      "zh": "和风天气查询工具",
      "en": "QWeather lookup tool"
    }
  },
  "chatluna": {
    "description": "和风天气查询工具"
  }
}
